  const poleMat = mat(0xe8e2d0, 0.6), loungeMat = mat(0xf4f1e8, 0.8), woodMat = mat(0x7a5a3a, 0.9), leafMat = mat(0x2f6b2f, 0.8), trunkMat = mat(0x8a6a45, 0.9);
  c
